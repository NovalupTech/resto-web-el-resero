---
import { menu_buttons } from "../utils/const";
import MenuButton from "./ui/MenuButton.astro";

// Menu section component
---

<section id="menu" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="font-display text-4xl md:text-5xl font-bold text-secondary-900 mb-4">
        Nuestra Parrilla
      </h2>
      <p class="text-xl text-secondary-800 max-w-2xl mx-auto">
        Los mejores cortes de carne, achuras y guarniciones a la parrilla con el sabor tradicional argentino
      </p>
    </div>

    <!-- Menu Categories -->
    <div class="sticky top-[88px] z-30 -mx-4 px-4 py-3 mb-8 bg-white/95 backdrop-blur-sm border-b border-secondary-100 md:static md:mx-0 md:px-0 md:py-0 md:mb-12 md:bg-transparent md:backdrop-blur-none md:border-0">
      <div class="flex flex-nowrap gap-3 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:flex-wrap md:justify-center md:gap-4 md:overflow-visible">
        {
          menu_buttons.map(({name, id, active}) => (
            <MenuButton name={name} id={id} active={active} />
          ))
        }
      </div>
    </div>

    <!-- Menu Items -->
    <div class="max-w-6xl mx-auto">
      <!-- Parrilla -->
      <div class="menu-category active" data-category="parrilla">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Achuras -->
          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Chorizo</h3>
                <p class="text-secondary-800">Chorizo criollo tradicional, jugoso y con el punto perfecto</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$7.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Morcilla</h3>
                <p class="text-secondary-800">Morcilla criolla casera, suave y sabrosa</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$7.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Provoleta</h3>
                <p class="text-secondary-800">Queso provolone a la parrilla con orégano y aceite de oliva</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$15.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Provoleta Nicolás</h3>
                <p class="text-secondary-800">Provoleta con jamón, tomate, huevo y orégano</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$18.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Provoleta Azul</h3>
                <p class="text-secondary-800">Provoleta con cebolla caramelizada y panceta</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$19.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Provoleta con Rúcula</h3>
                <p class="text-secondary-800">Provoleta con rúcula y salsas de tomate</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$18.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Provoleta Especial Resero</h3>
                <p class="text-secondary-800">Provoleta con panceta, roquefort, morrón y huevo frito</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$20.000</span>
            </div>
          </div>

          <!-- Pollo -->
          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">1/4 Pollo deshuesado al Roquefort</h3>
                <p class="text-secondary-800">Pollo tierno con salsa de roquefort</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$20.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">1/4 Pollo al Limón</h3>
                <p class="text-secondary-800">Pollo marinado con limón y hierbas</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$16.000</span>
            </div>
          </div>

          <!-- Achuras con precios variables -->
          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Chinchulín</h3>
                <p class="text-secondary-800">Chinchulines bien dorados y crocantes</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$12.000 / $15.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Riñón a la Provenzal</h3>
                <p class="text-secondary-800">Riñones al punto con salsa provenzal</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$13.000 / $16.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Molleja</h3>
                <p class="text-secondary-800">Mollejas tiernas y doradas</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$23.000 / $29.000</span>
            </div>
          </div>

          <!-- Cortes de Carne -->
          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Asado</h3>
                <p class="text-secondary-800">Clásico corte argentino con hueso</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$19.000 / $24.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Vacío</h3>
                <p class="text-secondary-800">Corte jugoso y tierno, ideal para compartir</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$20.000 / $26.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Entraña</h3>
                <p class="text-secondary-800">Corte con mucho sabor, cocido vuelta y vuelta</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$26.000 / $32.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Bife de Chorizo</h3>
                <p class="text-secondary-800">Corte premium, tierno y sabroso</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$22.000 / $28.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Bife de Chorizo Mariposa</h3>
                <p class="text-secondary-800">Bife de chorizo abierto en forma de mariposa</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$34.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Colita de Cuadril</h3>
                <p class="text-secondary-800">Corte tierno y jugoso</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$26.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Picaña</h3>
                <p class="text-secondary-800">Corte brasileño, tierno y sabroso</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$26.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Colita de Cuadril a la Mostaza</h3>
                <p class="text-secondary-800">Colita de cuadril con salsa de mostaza</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$28.000</span>
            </div>
          </div>

          <!-- Matambres -->
          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Matambrito con Salsa Criolla</h3>
                <p class="text-secondary-800">Matambrito con salsa criolla tradicional</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$24.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Matambre a la Pizza</h3>
                <p class="text-secondary-800">Matambre con salsa de tomate y mozzarella</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$28.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Matambre a la Pizza Especial</h3>
                <p class="text-secondary-800">Matambre a la pizza con ingredientes especiales</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$34.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Matambre al Roquefort</h3>
                <p class="text-secondary-800">Matambre con salsa de roquefort</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$34.000</span>
            </div>
          </div>

          <!-- Cerdo -->
          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Churrasquito de Cerdo</h3>
                <p class="text-secondary-800">Churrasquito de cerdo a la parrilla</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$26.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Churrasquito de Cerdo a la Pizza</h3>
                <p class="text-secondary-800">Churrasquito con salsa de tomate y mozzarella</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$34.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Churrasquito de Cerdo al Roquefort</h3>
                <p class="text-secondary-800">Churrasquito con salsa de roquefort</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$34.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Bondiola de Cerdo</h3>
                <p class="text-secondary-800">Bondiola de cerdo a la parrilla</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$22.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Bondiola de Cerdo a la Riojana</h3>
                <p class="text-secondary-800">Bondiola con papas fritas, huevo frito, Arvejas y Morrón</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$34.000</span>
            </div>
          </div>

          <!-- Mixes -->
          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
