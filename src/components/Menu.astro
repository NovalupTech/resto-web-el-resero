              </div>
              <span class="text-primary-500 font-bold text-xl">$205.000</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Empanadas y Sándwiches -->
      <div class="menu-category hidden" data-category="empanadas">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
