              <span class="text-primary-500 font-bold text-xl">$85.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Super Tony (Xeneize)</h3>
