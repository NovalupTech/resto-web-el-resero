              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Mix de Carne</h3>
                <p class="text-secondary-800">Bife, vacío, entraña, asado, matambre, colita de cuadril, picaña</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$130.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Mix de Achuras Lucas</h3>
                <p class="text-secondary-800">1 chorizo, 1 morcilla, chinchulín, riñón, molleja</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$45.000</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Parrilladas -->
      <div class="menu-category hidden" data-category="parrilladas">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Mini Parrillada (El Porve)</h3>
                <p class="text-secondary-800">Para 2 personas</p>
                <p class="text-secondary-800">1 Chorizo, 1 Morcilla, 1 Chinchulín, Riñón, Asado y Pollo</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$37.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Tradicional (El Grana)</h3>
                <p class="text-secondary-800">Para 3 a 4 personas</p>
                <p class="text-secondary-800">1 Chorizo, 1 Morcilla, 1 Chinchulín, Riñón, Asado y Pollo</p>
              </div>
              <span class="text-primary-500 font-bold text-xl">$59.000</span>
            </div>
          </div>

          <div class="bg-secondary-50 rounded-2xl p-6 hover:shadow-lg transition-shadow duration-300">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-display text-2xl font-semibold text-secondary-900 mb-2">Especial (El Diablo)</h3>
                <p class="text-secondary-800">Para 3 a 4 personas</p>
